<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Deactivate the old server-side field-based view from the previous
        version of this module (which added picking_product_color via Python).
        The coloring is now handled entirely client-side in JS.
    -->
    <record id="view_picking_form_line_color" model="ir.ui.view">
        <field name="name">stock.picking.form.delivery.line.color (disabled)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <!-- no-op placeholder; actual coloring is done in JS -->
            <xpath expr="//form" position="attributes">
                <attribute name="data-dlc">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
