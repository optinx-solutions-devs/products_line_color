<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_line_color_tree" model="ir.ui.view">
        <field name="name">line.color.tree</field>
        <field name="model">line.color</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="background_color" widget="color"/>
                <field name="border_color" widget="color"/>
                <field name="hover_color" widget="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_line_color_form" model="ir.ui.view">
        <field name="name">line.color.form</field>
        <field name="model">line.color</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Palette">
                        <field name="background_color" widget="color"/>
                        <field name="border_color" widget="color"/>
                        <field name="hover_color" widget="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_line_color_search" model="ir.ui.view">
        <field name="name">line.color.search</field>
        <field name="model">line.color</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_line_color" model="ir.actions.act_window">
        <field name="name">Colors</field>
        <field name="res_model">line.color</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_line_color_search"/>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="view_line_color_config_tree" model="ir.ui.view">
        <field name="name">line.color.config.tree</field>
        <field name="model">line.color.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
                <field name="apply_sale"/>
                <field name="apply_purchase"/>
                <field name="apply_invoice"/>
                <field name="apply_picking_outgoing"/>
                <field name="apply_picking_incoming"/>
                <field name="apply_picking_internal"/>
            </list>
        </field>
    </record>

    <record id="view_line_color_config_form" model="ir.ui.view">
        <field name="name">line.color.config.form</field>
        <field name="model">line.color.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group string="Documents">
                        <field name="apply_sale"/>
                        <field name="apply_purchase"/>
                        <field name="apply_invoice"/>
                    </group>
                    <group string="Inventory Operations">
                        <field name="apply_picking_outgoing"/>
                        <field name="apply_picking_incoming"/>
                        <field name="apply_picking_internal"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_line_color_config" model="ir.actions.act_window">
        <field name="name">Line Color Scope</field>
        <field name="res_model">line.color.config</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="menu_line_color"
              name="Line Colors"
              parent="stock.menu_stock_config_settings"
              action="action_line_color"
              groups="stock.group_stock_manager"
              sequence="80"/>

    <menuitem id="menu_sale_config_line_colors"
              name="Line Colors"
              parent="sale.menu_sale_config"
              action="action_line_color"
              groups="sales_team.group_sale_manager"
              sequence="60"/>

    <menuitem id="menu_line_color_scope"
              name="Line Color Scope"
              parent="stock.menu_stock_config_settings"
              action="action_line_color_config"
              groups="stock.group_stock_manager"
              sequence="81"/>

    <menuitem id="menu_sale_config_line_color_scope"
              name="Line Color Scope"
              parent="sale.menu_sale_config"
              action="action_line_color_config"
              groups="sales_team.group_sale_manager"
              sequence="61"/>
</odoo>
